{
  "name": "whitelabel-whatsapp-crm",
  "version": "2.0.0",
  "description": "White-label WhatsApp CRM (Wati-style inbox, broadcasts, automation) using Meta Cloud API and Neon Postgres",
  "main": "index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "start:prod": "NODE_ENV=production node index.js",
    "dev": "node index.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:api": "playwright test tests/api.spec.js",
    "test:flow": "playwright test tests/flow.spec.js",
    "test:sheets": "playwright test tests/sheets.spec.js",
    "test:integration": "playwright test tests/integration.spec.js",
    "test:performance": "playwright test tests/performance.spec.js",
    "test:quick": "playwright test tests/api.spec.js tests/flow.spec.js",
    "test:report": "playwright show-report",
    "test:run": "node run-tests.js",
    "test:summary": "node test-summary.js"
  },
  "keywords": [
    "whatsapp",
    "crm",
    "chatbot",
    "meta-cloud-api",
    "white-label"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "googleapis": "^131.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0"
  }
}
