# ============================================================
# White-label WhatsApp CRM — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Rebrand to any business WITHOUT touching code.
# ============================================================

# ─── Branding (white-label) ──────────────────────────────────
BUSINESS_NAME="Your Business"
BUSINESS_TYPE="general business"
CONTACT_NUMBER="+91 XXXXXXXXXX"
BUSINESS_ADDRESS="City, Country"
WORKING_HOURS="Mon–Sat: 10 AM – 7 PM"
BRAND_COLOR="#10b981"
LOGO_URL=""

# ─── Bot (generic auto-responder) ───────────────────────────
# BOT_ENABLED=false turns the bot fully silent (pure human inbox).
BOT_ENABLED="true"
# First reply to a new conversation ("" to disable).
WELCOME_MESSAGE="👋 Welcome! How can we help you today? Reply *agent* to talk to our team."
# Reply when nothing matches on the first message ("" = stay silent,
# let a human answer — recommended).
FALLBACK_MESSAGE=""
# Words that trigger the human-handoff reply (comma-separated).
HUMAN_KEYWORDS="agent,human,support,call me,call back,callback,help"
# Optional keyword auto-replies as JSON: [{"match":"price","reply":"..."}]
BOT_RULES_JSON=""
# Inactivity nudge before a session expires ("" to disable).
NUDGE_MESSAGE="👋 Are you still there? Reply to continue, or reply *agent* to talk to our team."
ERROR_MESSAGE="⚠️ Sorry, something went wrong on our side. Please try again, or reply *agent* to talk to our team."
SESSION_TIMEOUT_MS=900000

# ─── Neon Postgres (database, OPTIONAL) ─────────────────────
# Paste your Neon pooled connection string to connect. Leave empty to run
# without a database (empty UI, nothing persists — good for UI review /
# fresh start). After connecting a FRESH database, run neon-schema.sql once:
#   psql $DATABASE_URL -f neon-schema.sql
DATABASE_URL=
# Skips login + treats all API auth as demo admin. Auto-enabled when
# DATABASE_URL is missing. Never enable in production with real data.
DEMO_MODE=true

# ─── Meta WhatsApp Cloud API ────────────────────────────────
META_ACCESS_TOKEN=your_meta_access_token
META_PHONE_NUMBER_ID=your_phone_number_id
META_VERIFY_TOKEN=your_webhook_verify_token
META_API_VERSION=v22.0
META_BOT_NUMBER=+91XXXXXXXXXX

# ─── Admin alerts (optional) ────────────────────────────────
# WhatsApp number that receives delivery-failure + follow-up alerts.
# Leave empty to disable WhatsApp alerts (CRM notifications still work).
OWNER_PHONE=
ADMIN_TOKEN=your-secret-token-here

# ─── AI Assistant (OpenRouter, optional) ────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_SITE_URL=https://your-app-url.example
OPENROUTER_APP_NAME="WhatsApp CRM"

# ─── Server ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
