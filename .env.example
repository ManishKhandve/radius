# ============================================================
# Cleanly WhatsApp CRM — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# ============================================================

# ─── Business ────────────────────────────────────────────────
BUSINESS_NAME="Cleanly WhatsApp"
OWNER_WHATSAPP="91XXXXXXXXXX@c.us"
OWNER_PHONE="91XXXXXXXXXX"
GLIDE_APP_URL="https://your-app.glideapp.io"
WORKING_HOURS="Mon–Sat: 10 AM – 7 PM"
ADDRESS="City, Country"
CONTACT_NUMBER="+91 XXXXXXXXXX"

# ─── Google Sheets ───────────────────────────────────────────
SPREADSHEET_ID="YOUR_SPREADSHEET_ID_HERE"
# For cloud (Render): paste the full JSON credentials as a string
# GOOGLE_CREDENTIALS='{...}'
# For local: use a path to the credentials file
# GOOGLE_CREDENTIALS_PATH="./credentials.json"

# ─── Supabase (CRM database) ────────────────────────────────
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# ─── Meta WhatsApp Cloud API ────────────────────────────────
META_ACCESS_TOKEN=your_meta_access_token
META_PHONE_NUMBER_ID=your_phone_number_id
META_VERIFY_TOKEN=your_webhook_verify_token
META_API_VERSION=v22.0
META_BOT_NUMBER=+91XXXXXXXXXX

# ─── Security ───────────────────────────────────────────────
# IMPORTANT: Change this to a strong random string before deploying!
ADMIN_TOKEN=your-secret-token-here
UPI_ID=your-upi-id@bank

# ─── AI Assistant (OpenRouter) ──────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_SITE_URL=https://your-app-url.example
OPENROUTER_APP_NAME="Cleanly WhatsApp CRM"

# ─── Server ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development